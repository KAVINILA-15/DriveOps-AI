# ==============================================================================
# DriveOps-AI Backend Environment Configuration
# ==============================================================================

# Server Port (Default: 5000)
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL / Supabase)
# Option A: Direct PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/driveops

# Option B: Supabase Cloud Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Intelligence Engine (Optional LLM Integration)
# Provide Gemini API Key for deep root-cause synthesis
GEMINI_API_KEY=your-gemini-api-key

# Or generic OpenAI API Key
# OPENAI_API_KEY=your-openai-api-key
# AI_API_KEY=your-ai-api-key

# Client CORS Settings (optional, comma-separated)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
