# DriveOps-AI Supabase Configuration
# Replace the values below with your Supabase Project URL and Anon/Publishable API Key.
# Found in: Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# DriveOps-AI Backend API URL (optional in local dev as Vite proxies /api to port 5000)
VITE_BACKEND_URL=http://localhost:5000
